
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#002D62">

  <title>Daily RM/FSE Report | FirstBank Kontagora</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #002D62;
      --blue: #0066B3;
      --gold: #D4AF37;
      --bg: #F3F6FA;
      --white: #FFFFFF;
      --text: #172B4D;
      --muted: #64748B;
      --border: #E1E8F0;
      --success: #16803D;
      --danger: #C62828;
      --radius: 12px;
      --shadow: 0 8px 30px rgba(16, 42, 80, .06);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
    }

    button, input, select, textarea { font: inherit; }

    button { -webkit-tap-highlight-color: transparent; }

    .topbar {
      height: 5px;
      background: linear-gradient(90deg, var(--navy) 0 72%, var(--gold) 72% 100%);
    }

    .page {
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 24px 60px;
    }

    .brand-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .brand img {
      width: 66px;
      height: 66px;
      object-fit: contain;
      background: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 7px;
    }

    .brand h1 {
      color: var(--navy);
      font-size: 21px;
      line-height: 1.3;
      margin: 0 0 4px;
      letter-spacing: -.5px;
    }

    .brand p {
      color: var(--muted);
      margin: 0;
      font-size: 12px;
    }

    .internal-tag {
      color: var(--navy);
      background: #E8F0FA;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .hero {
      background: linear-gradient(115deg, #002D62, #064A87);
      color: white;
      padding: 30px;
      border-radius: 16px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 200px;
      height: 200px;
      border: 32px solid rgba(255,255,255,.055);
      border-radius: 50%;
      right: -50px;
      top: -90px;
      pointer-events: none;
    }

    .hero .eyebrow {
      color: #E8D18A;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      margin-bottom: 7px;
    }

    .hero h2 {
      font-size: clamp(23px, 3vw, 30px);
      line-height: 1.3;
      letter-spacing: -.7px;
      margin: 0 0 8px;
    }

    .hero p {
      max-width: 600px;
      color: #D9E6F5;
      margin: 0;
      font-size: 13px;
    }

    .report-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 24px;
      margin-top: 22px;
      color: #F0F5FC;
      font-size: 12px;
    }

    .report-meta span::before {
      content: "•";
      color: var(--gold);
      font-size: 16px;
      margin-right: 8px;
    }

    .notice {
      background: #FFF9E8;
      border: 1px solid #F0DFAB;
      border-radius: 10px;
      padding: 12px 15px;
      color: #74581A;
      font-size: 12px;
      margin-bottom: 22px;
    }

    .form-shell {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .form-intro {
      padding: 23px 28px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .form-intro h3 {
      font-size: 16px;
      margin: 0 0 3px;
      color: var(--navy);
    }

    .form-intro p {
      font-size: 12px;
      color: var(--muted);
      margin: 0;
    }

    .required-note {
      color: var(--muted);
      font-size: 11px;
      white-space: nowrap;
    }

    form { padding: 8px 28px 28px; }

    .section {
      padding-top: 25px;
      margin-top: 16px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-bottom: 20px;
    }

    .section-number {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: #EAF2FC;
      color: var(--blue);
      font-weight: 800;
      font-size: 12px;
    }

    .section-heading h3 {
      color: var(--navy);
      font-size: 15px;
      margin: 0;
      font-weight: 800;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 12px;
      margin: 2px 0 0;
    }

    .section-rule {
      height: 1px;
      background: var(--border);
      margin-top: 22px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .grid.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .field { min-width: 0; }

    .field.full { grid-column: 1 / -1; }

    label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #334766;
      margin-bottom: 7px;
    }

    .req { color: var(--danger); }

    input, select, textarea {
      width: 100%;
      min-height: 44px;
      border: 1px solid #D8E1EC;
      background: #FBFCFE;
      color: var(--text);
      border-radius: 8px;
      padding: 11px 12px;
      outline: none;
      transition: border-color .2s, box-shadow .2s, background .2s;
    }

    input::placeholder, textarea::placeholder {
      color: #9AA8BA;
    }

    input:hover, select:hover, textarea:hover {
      border-color: #A8BBD2;
      background: white;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--blue);
      background: white;
      box-shadow: 0 0 0 3px rgba(0,102,179,.12);
    }

    textarea {
      resize: vertical;
      min-height: 110px;
    }

    .helper {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 11px;
    }

    .repeat-list {
      display: grid;
      gap: 14px;
    }

    .entry-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 19px;
      background: #FCFDFE;
    }

    .entry-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 17px;
    }

    .entry-title {
      color: var(--navy);
      font-size: 12px;
      font-weight: 800;
    }

    .entry-count {
      display: inline-grid;
      place-items: center;
      min-width: 24px;
      height: 24px;
      padding: 0 6px;
      background: #EAF2FC;
      color: var(--blue);
      border-radius: 7px;
      margin-right: 7px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 8px;
      padding: 10px 15px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background .2s, transform .2s;
    }

    .btn-add {
      color: var(--blue);
      background: white;
      border: 1px dashed #8CB2DC;
      margin-top: 14px;
    }

    .btn-add:hover { background: #F0F6FD; }

    .btn-remove {
      color: var(--danger);
      border: 1px solid #F0CDCD;
      background: #FFF8F8;
      padding: 6px 10px;
      font-size: 11px;
    }

    .btn-remove:hover { background: #FCECEC; }

    .summary-note {
      margin-top: 24px;
      background: #F7F9FC;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 15px;
      color: var(--muted);
      font-size: 12px;
    }

    .form-actions {
      margin-top: 28px;
      padding-top: 23px;
      border-top: 1px solid var(--border);
    }

    .btn-submit {
      width: 100%;
      min-height: 50px;
      background: var(--navy);
      border: 1px solid var(--navy);
      color: white;
      font-size: 14px;
    }

    .btn-submit:hover {
      background: #00417E;
      transform: translateY(-1px);
    }

    .btn-submit:disabled {
      opacity: .65;
      cursor: wait;
      transform: none;
    }

    .submit-hint {
      text-align: center;
      color: var(--muted);
      font-size: 11px;
      margin: 12px 0 0;
    }

    .footer {
      text-align: center;
      padding: 24px 10px 0;
      color: var(--muted);
      font-size: 11px;
    }

    .footer strong { color: var(--navy); }

    .status-message {
      padding: 12px 14px;
      border-radius: 8px;
      margin-top: 15px;
      font-size: 12px;
      display: none;
    }

    .status-message.error {
      display: block;
      color: #9B1C1C;
      background: #FFF1F1;
      border: 1px solid #F3CCCC;
    }

    @media (max-width: 760px) {
      .page { padding: 20px 14px 35px; }
      .brand-header { align-items: flex-start; }
      .brand img { width: 54px; height: 54px; }
      .brand h1 { font-size: 17px; }
      .internal-tag { font-size: 10px; padding: 6px 8px; }
      .hero { padding: 24px 20px; }
      .form-intro { padding: 20px; }
      form { padding: 5px 20px 22px; }
      .grid.three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 520px) {
      .brand-header { flex-wrap: wrap; }
      .internal-tag { margin-left: 68px; }
      .brand { align-items: flex-start; }
      .brand h1 { font-size: 16px; }
      .hero h2 { font-size: 23px; }
      .grid, .grid.three { grid-template-columns: 1fr; }
      .form-intro { align-items: flex-start; flex-direction: column; }
      .entry-card { padding: 14px; }
      .entry-top { align-items: flex-start; }
      .report-meta { gap: 7px 15px; }
      .required-note { white-space: normal; }
    }

    @media print {
      body { background: white; }
      .page { max-width: 100%; padding: 0; }
      .hero { background: white; color: var(--navy); border: 1px solid var(--border); }
      .hero p, .hero .eyebrow, .report-meta { color: var(--navy); }
      .notice, .btn-add, .btn-remove, .form-actions, .internal-tag { display: none !important; }
      .form-shell { box-shadow: none; }
      input, select, textarea { background: white; }
      .entry-card { break-inside: avoid; }
    }
  </style>
</head>

<body>
  <div class="topbar"></div>

  <main class="page">
    <header class="brand-header">
      <div class="brand">
        <img
          src="https://upload.wikimedia.org/wikipedia/commons/2/23/First_Bank_of_Nigeria_logo.svg"
          alt="FirstBank logo"
        >
        <div>
          <h1>FirstBank Nigeria</h1>
          <p>Kontagora Branch · Relationship Management</p>
        </div>
      </div>
      <span class="internal-tag">DAILY OPERATIONS</span>
    </header>

    <section class="hero">
      <div class="eyebrow">Branch Reporting Portal</div>
      <h2>Daily RM / FSE Activity Report</h2>
      <p>
        Record daily business development activities, customer engagements,
        deposit inflows, loan progress, recoveries and channel visits.
      </p>
      <div class="report-meta">
        <span>Kontagora Branch</span>
        <span>Relationship Management</span>
        <span>Daily Submission</span>
      </div>
    </section>

    <div class="notice">
      <strong>Reporting reminder:</strong>
      Complete all mandatory fields and verify entries before submission.
      Follow the bank's approved procedures for handling customer information.
    </div>

    <section class="form-shell">
      <div class="form-intro">
        <div>
          <h3>Activity Report Form</h3>
          <p>Provide accurate information for the reporting date.</p>
        </div>
        <div class="required-note">
          <span class="req">*</span> Required fields
        </div>
      </div>

      <form id="report-form"
            action="https://formsubmit.co/hrahym9ja@gmail.com"
            method="POST">

        <input type="hidden" name="_subject"
               value="Daily RM/FSE Activity Report - FirstBank Kontagora">
        <input type="hidden" name="_template" value="table">

        <!-- 01: Officer details -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">01</div>
            <div>
              <h3>Officer Information</h3>
              <p>Identify the reporting staff member and reporting date.</p>
            </div>
          </div>

          <div class="grid three">
            <div class="field">
              <label for="report-date">Report Date <span class="req">*</span></label>
              <input type="date" id="report-date" name="Report Date" required>
            </div>

            <div class="field">
              <label for="staff-name">Staff Name <span class="req">*</span></label>
              <input type="text" id="staff-name" name="Staff Name"
                     placeholder="Enter full name" autocomplete="name" required>
            </div>

            <div class="field">
              <label for="staff-id">Staff ID <span class="req">*</span></label>
              <input type="text" id="staff-id" name="Staff ID"
                     placeholder="Enter staff ID" required>
            </div>
          </div>
        </section>

        <div class="section-rule"></div>

        <!-- 02: CASA -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">02</div>
            <div>
              <h3>CASA — Major Fresh Inflows</h3>
              <p>Current and savings account deposit performance.</p>
            </div>
          </div>

          <div class="grid">
            <div class="field full">
              <label for="casa-details">Inflow Description and Source</label>
              <textarea id="casa-details" name="CASA Details"
                placeholder="Record significant inflows, source of funds, amounts, customer segments and relevant follow-up actions."></textarea>
            </div>
          </div>
        </section>

        <div class="section-rule"></div>

        <!-- 03: Loans -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">03</div>
            <div>
              <h3>Loans and Advances (LAD)</h3>
              <p>Loan pipeline, applications, disbursements and opportunities.</p>
            </div>
          </div>

          <div class="grid">
            <div class="field full">
              <label for="lad-details">Progress and Updates</label>
              <textarea id="lad-details" name="LAD Report"
                placeholder="Summarize applications, approval status, disbursements, pending documentation, prospects and next steps."></textarea>
            </div>
          </div>
        </section>

        <div class="section-rule"></div>

        <!-- 04: Customer visits -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">04</div>
            <div>
              <h3>Major Customer Visitations</h3>
              <p>Record meetings, customer needs, outcomes and commitments.</p>
            </div>
          </div>

          <div id="visitation-list" class="repeat-list"></div>
          <button type="button" class="btn btn-add"
                  data-add="visitation">+ Add Customer Visit</button>
        </section>

        <div class="section-rule"></div>

        <!-- 05: Recoveries -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">05</div>
            <div>
              <h3>Loan Recovery</h3>
              <p>Document recovery activities and amounts received.</p>
            </div>
          </div>

          <div id="recovery-list" class="repeat-list"></div>
          <button type="button" class="btn btn-add"
                  data-add="recovery">+ Add Recovery Record</button>
        </section>

        <div class="section-rule"></div>

        <!-- 06: Agents -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">06</div>
            <div>
              <h3>Agent Network Visitation</h3>
              <p>Track agent activity, outlet status and support requirements.</p>
            </div>
          </div>

          <div id="agent-list" class="repeat-list"></div>
          <button type="button" class="btn btn-add"
                  data-add="agent">+ Add Agent Visit</button>
        </section>

        <div class="section-rule"></div>

        <!-- 07: Merchants -->
        <section class="section">
          <div class="section-heading">
            <div class="section-number">07</div>
            <div>
              <h3>Merchant Visitation</h3>
              <p>Monitor merchant activity, POS operations and escalations.</p>
            </div>
          </div>

          <div id="merchant-list" class="repeat-list"></div>
          <button type="button" class="btn btn-add"
                  data-add="merchant">+ Add Merchant Visit</button>
        </section>

        <div class="summary-note">
          <strong>Before submitting:</strong>
          Confirm that the report date, staff details and activity records
          are correct. Do not include PINs, passwords, OTPs or other
          authentication credentials.
        </div>

        <div id="form-status" class="status-message"
             role="alert" aria-live="polite"></div>

        <div class="form-actions">
          <button type="submit" class="btn btn-submit" id="submit-button">
            Submit Daily Report <span aria-hidden="true">→</span>
          </button>
          <p class="submit-hint">
            Your report will be sent to the configured reporting email address.
          </p>
        </div>
      </form>
    </section>

    <footer class="footer">
      <strong>FirstBank Nigeria · Kontagora Branch</strong>
      <p>Daily RM / FSE Reporting Portal</p>
    </footer>
  </main>

  <script>
    (() => {
      "use strict";

      const form = document.getElementById("report-form");
      const dateInput = document.getElementById("report-date");
      const statusBox = document.getElementById("form-status");

      // Use the user's local calendar date rather than UTC.
      function localDateString(date = new Date()) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      }

      dateInput.value = localDateString();
      dateInput.max = localDateString();

      const definitions = {
        visitation: {
          container: "visitation-list",
          title: "Customer Visit",
          fields: [
            {
              label: "Customer / Business Name",
              name: "Customer Name",
              placeholder: "Enter customer or business name"
            },
            {
              label: "Discussion and Outcome",
              name: "Customer Discussion",
              type: "textarea",
              full: true,
              placeholder: "Discussion points, customer needs, outcomes and next actions"
            }
          ]
        },

        recovery: {
          container: "recovery-list",
          title: "Recovery Record",
          fields: [
            {
              label: "Account Name / Reference",
              name: "Recovery Account Details",
              placeholder: "Use only bank-approved identifiers"
            },
            {
              label: "Amount Recovered (₦)",
              name: "Recovery Amount",
              type: "number",
              min: "0",
              step: "0.01",
              placeholder: "0.00"
            },
            {
              label: "Recovery Notes",
              name: "Recovery Notes",
              type: "textarea",
              full: true,
              placeholder: "Recovery status, outstanding actions or follow-up"
            }
          ]
        },

        agent: {
          container: "agent-list",
          title: "Agent Visit",
          fields: [
            {
              label: "Agent / Outlet Name",
              name: "Agent Name",
              placeholder: "Enter agent or outlet name"
            },
            {
              label: "Approved Account Reference",
              name: "Agent Account Details",
              placeholder: "Use an approved identifier"
            },
            {
              label: "Agent Status",
              name: "Agent Status",
              type: "select",
              options: ["Active", "Inactive", "Pending Onboarding"]
            },
            {
              label: "Location / Area",
              name: "Agent Location",
              placeholder: "Area visited"
            },
            {
              label: "Visit Notes",
              name: "Agent Visit Notes",
              type: "textarea",
              full: true,
              placeholder: "Activity, challenges, support provided and next steps"
            }
          ]
        },

        merchant: {
          container: "merchant-list",
          title: "Merchant Visit",
          fields: [
            {
              label: "Merchant / Business Name",
              name: "Merchant Name",
              placeholder: "Enter merchant name"
            },
            {
              label: "Approved Account Reference",
              name: "Merchant Account Details",
              placeholder: "Use an approved identifier"
            },
            {
              label: "Merchant Status",
              name: "Merchant Status",
              type: "select",
              options: [
                "Active (POS Operational)",
                "Low Volume / Inactive",
                "Issue Escalated"
              ]
            },
            {
              label: "Location / Store Address",
              name: "Merchant Location",
              placeholder: "Location visited"
            },
            {
              label: "Visit Notes",
              name: "Merchant Visit Notes",
              type: "textarea",
              full: true,
              placeholder: "Transaction activity, issues, action taken and follow-up"
            }
          ]
        }
      };

      // Give every entry its own unique IDs and field names.
      function createField(field, index, sectionKey) {
        const wrapper = document.createElement("div");
        wrapper.className = "field" + (field.full ? " full" : "");

        const id = `${sectionKey}-${index}-${field.name
          .toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

        const label = document.createElement("label");
        label.htmlFor = id;
        label.textContent = field.label;
        wrapper.appendChild(label);

        let control;

        if (field.type === "textarea") {
          control = document.createElement("textarea");
          control.rows = 3;
          control.placeholder = field.placeholder || "";
        } else if (field.type === "select") {
          control = document.createElement("select");

          const blank = document.createElement("option");
          blank.value = "";
          blank.textContent = "Select status";
          control.appendChild(blank);

          field.options.forEach(optionText => {
            const option = document.createElement("option");
            option.value = optionText;
            option.textContent = optionText;
            control.appendChild(option);
          });
        } else {
          control = document.createElement("input");
          control.type = field.type || "text";

          if (field.min !== undefined) control.min = field.min;
          if (field.step !== undefined) control.step = field.step;
          if (field.placeholder) control.placeholder = field.placeholder;
        }

        control.id = id;
        control.name = `${field.name} [${index}]`;
        control.autocomplete = "off";

        wrapper.appendChild(control);
        return wrapper;
      }

      function addEntry(sectionKey) {
        const definition = definitions[sectionKey];
        if (!definition) return;

        const container = document.getElementById(definition.container);
        const index = container.children.length + 1;

        const card = document.createElement("article");
        card.className = "entry-card";

        const top = document.createElement("div");
        top.className = "entry-top";

        const heading = document.createElement("div");
        heading.className = "entry-title";

        const count = document.createElement("span");
        count.className = "entry-count";
        count.textContent = index;

        heading.append(count, document.createTextNode(definition.title));
        top.appendChild(heading);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "btn btn-remove";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${definition.title}`);

        remove.addEventListener("click", () => {
          card.remove();
          renumber(sectionKey);
        });

        top.appendChild(remove);
        card.appendChild(top);

        const grid = document.createElement("div");
        grid.className = "grid";

        definition.fields.forEach(field => {
          grid.appendChild(createField(field, index, sectionKey));
        });

        card.appendChild(grid);
        container.appendChild(card);
      }

      function renumber(sectionKey) {
        const container = document.getElementById(
          definitions[sectionKey].container
        );

        Array.from(container.children).forEach((card, index) => {
          const count = card.querySelector(".entry-count");
          if (count) count.textContent = index + 1;
        });
      }

      document.querySelectorAll("[data-add]").forEach(button => {
        button.addEventListener("click", () => {
          addEntry(button.dataset.add);
        });
      });

      // Start with one entry in each repeatable section.
      Object.keys(definitions).forEach(addEntry);

      form.addEventListener("submit", event => {
        statusBox.className = "status-message";
        statusBox.textContent = "";

        if (dateInput.value > localDateString()) {
          event.preventDefault();
          statusBox.className = "status-message error";
          statusBox.textContent = "The report date cannot be in the future.";
          dateInput.focus();
          return;
        }

        // Let the browser perform native validation and submit the form.
        // Do not simulate a successful email delivery here.
      });
    })();
  </script>
</body>
</html>
